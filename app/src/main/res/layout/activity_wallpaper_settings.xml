<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_primary"
        android:elevation="2dp"
        app:title="@string/wallpaper_settings_title"
        app:titleTextColor="@color/white"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_input_field"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <Button
                android:id="@+id/buttonPickImage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/wallpaper_pick_image"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:elevation="0dp" />

            <Button
                android:id="@+id/buttonResetWallpaper"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_field"
                android:text="@string/action_reset_wallpaper_full"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:elevation="0dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:background="@color/divider" />

            <RadioGroup
                android:id="@+id/radioGroupMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/radioAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wallpaper_mode_all"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radioContactsOnly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/wallpaper_mode_contacts"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radioSpecific"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/wallpaper_mode_specific"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radioNone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/wallpaper_mode_none"
                    android:textColor="@color/text_primary" />

            </RadioGroup>

            <Button
                android:id="@+id/buttonChooseContacts"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_field"
                android:text="@string/wallpaper_choose_contacts"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:elevation="0dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
